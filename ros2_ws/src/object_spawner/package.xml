<?xml version="1.0"?>
<package format="3">
  <name>object_spawner</name>
  <version>0.0.1</version>
  <description>
    URDF, meshes, ros2_control configuration, Gazebo world and launch file for
    the four-wheel differential-drive mobile manipulator, plus the ramp and
    cube models used in the sorting tests.
  </description>
  <maintainer email="adithyapothula123@gmail.com">Adithya Pothula</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>gazebo_ros</build_depend>
  <build_depend>controller_manager</build_depend>
  <build_depend>robot_state_publisher</build_depend>
  <build_depend>joint_state_broadcaster</build_depend>
  <build_depend>ros2_control</build_depend>
  <build_depend>gazebo_ros2_control</build_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>boeing_gazebo_model_attachment_plugin</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
